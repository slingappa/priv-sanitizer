#!/usr/bin/env bash
set -Eeuo pipefail

# Repository-local launcher. Keep the caller's working directory intact so
# `./priv-sanitizer` with no arguments batches videos in that folder.
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Reuse the same local FFmpeg/Tesseract setup as the documented runtime.
if [[ -f "${ROOT_DIR}/scripts/activate.sh" ]]; then
  # shellcheck disable=SC1090
  source "${ROOT_DIR}/scripts/activate.sh" >/dev/null
fi

DOCKER_MODE="${PRIV_SANITIZER_USE_DOCKER:-auto}"
DOCKER_RUNTIME_FILE="${ROOT_DIR}/.docker-runtime"
if [[ "$DOCKER_MODE" == "1" || ( "$DOCKER_MODE" == "auto" && -f "$DOCKER_RUNTIME_FILE" ) ]]; then
  command -v docker >/dev/null 2>&1 || {
    printf '[priv-sanitizer] ERROR: Docker runtime is enabled but Docker is unavailable. Set PRIV_SANITIZER_USE_DOCKER=0 to use local Python.\n' >&2
    exit 1
  }
  if [[ -f "$DOCKER_RUNTIME_FILE" ]]; then
    DOCKER_IMAGE="$(head -n 1 "$DOCKER_RUNTIME_FILE")"
  else
    DOCKER_IMAGE="${PRIV_SANITIZER_DOCKER_IMAGE:-priv-sanitizer:local}"
  fi
  [[ -n "$DOCKER_IMAGE" ]] || {
    printf '[priv-sanitizer] ERROR: Docker image tag is empty.\n' >&2
    exit 1
  }
  docker image inspect "$DOCKER_IMAGE" >/dev/null 2>&1 || {
    printf '[priv-sanitizer] ERROR: Docker image %s is unavailable; run scripts/install.sh --docker.\n' "$DOCKER_IMAGE" >&2
    exit 1
  }
  DOCKER_ARGS=(run --rm --user "$(id -u):$(id -g)" --volume "$PWD:/work" --workdir /work)
  # Preserve an interactive terminal so the container can animate progress;
  # redirected/piped runs remain non-interactive and line-oriented.
  if [[ -t 1 || -t 2 ]]; then
    DOCKER_ARGS+=(--tty)
    [[ -t 0 ]] && DOCKER_ARGS+=(--interactive)
  fi
  for ENV_NAME in PRIV_SANITIZER_FFMPEG_THREADS PRIV_SANITIZER_X264_PRESET PRIV_SANITIZER_QUIET PRIV_SANITIZER_VERBOSE PRIV_SANITIZER_HEARTBEAT_SECONDS PRIV_SANITIZER_AUDIO_ANALYSIS; do
    if [[ -n "${!ENV_NAME:-}" ]]; then
      DOCKER_ARGS+=(--env "$ENV_NAME=${!ENV_NAME}")
    fi
  done
  exec docker "${DOCKER_ARGS[@]}" "$DOCKER_IMAGE" "$@"
fi

PYTHON_BIN="${PRIV_SANITIZER_PYTHON:-${PRIV_SANITIZER_VENV:-${ROOT_DIR}/.venv}/bin/python}"
if [[ ! -x "$PYTHON_BIN" ]]; then
  PYTHON_BIN="$(command -v python3 || true)"
fi
if [[ -z "$PYTHON_BIN" || ! -x "$PYTHON_BIN" ]]; then
  printf '[priv-sanitizer] ERROR: Python 3 was not found; run scripts/install.sh first.\n' >&2
  exit 1
fi

# Make the checkout importable when this launcher is called from a separate
# recordings directory.
export PYTHONPATH="${ROOT_DIR}${PYTHONPATH:+:${PYTHONPATH}}"

# The launcher has a deliberately explicit no-argument contract: process all
# videos in the caller's current directory and write the selected outputs to
# that directory's outputs_sanitized/ folder.
if (($# == 0)); then
  exec "$PYTHON_BIN" -m priv_sanitizer batch \
    --input "$PWD" \
    --output "$PWD/outputs_sanitized" \
    --artifacts "$PWD/artifacts"
fi

exec "$PYTHON_BIN" -m priv_sanitizer "$@"
