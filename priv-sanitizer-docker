#!/usr/bin/env bash
set -Eeuo pipefail

# Direct Docker launcher. It keeps the caller's working directory as the
# container workspace, so no-argument invocation batches that folder.
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOCKER_RUNTIME_FILE="${ROOT_DIR}/.docker-runtime"

command -v docker >/dev/null 2>&1 || {
  printf '[priv-sanitizer-docker] ERROR: Docker was not found on PATH.\n' >&2
  exit 1
}

if [[ -f "$DOCKER_RUNTIME_FILE" ]]; then
  DOCKER_IMAGE="$(head -n 1 "$DOCKER_RUNTIME_FILE")"
else
  DOCKER_IMAGE="${PRIV_SANITIZER_DOCKER_IMAGE:-priv-sanitizer:local}"
fi

[[ -n "$DOCKER_IMAGE" ]] || {
  printf '[priv-sanitizer-docker] ERROR: Docker image tag is empty.\n' >&2
  exit 1
}

docker image inspect "$DOCKER_IMAGE" >/dev/null 2>&1 || {
  printf '[priv-sanitizer-docker] ERROR: image %s is unavailable. Run:\n' "$DOCKER_IMAGE" >&2
  printf '  cd %q && bash scripts/install.sh --docker-only\n' "$ROOT_DIR" >&2
  exit 1
}

DOCKER_ARGS=(
  run --rm
  --user "$(id -u):$(id -g)"
  --volume "$(pwd -P):/work"
  --workdir /work
)
# Preserve an interactive terminal so the container can animate progress;
# redirected/piped runs remain non-interactive and line-oriented.
if [[ -t 1 || -t 2 ]]; then
  DOCKER_ARGS+=(--tty)
  [[ -t 0 ]] && DOCKER_ARGS+=(--interactive)
fi

for ENV_NAME in PRIV_SANITIZER_WHITEBOARD PRIV_SANITIZER_FFMPEG_THREADS PRIV_SANITIZER_X264_PRESET PRIV_SANITIZER_QUIET PRIV_SANITIZER_VERBOSE PRIV_SANITIZER_HEARTBEAT_SECONDS PRIV_SANITIZER_AUDIO_ANALYSIS PRIV_SANITIZER_ADAPTIVE_SAMPLING PRIV_SANITIZER_DENSE_FACE_SAMPLING PRIV_SANITIZER_DENSE_FACE_FPS PRIV_SANITIZER_FACE_DIFF_THRESHOLD PRIV_SANITIZER_FACE_FALLBACK_SECONDS PRIV_SANITIZER_DENSE_FACE_WINDOWING PRIV_SANITIZER_DENSE_FACE_WINDOW_SECONDS PRIV_SANITIZER_DENSE_FACE_SPARSE_SECONDS PRIV_SANITIZER_SCENE_DETECTION PRIV_SANITIZER_SCENE_THRESHOLD PRIV_SANITIZER_SCENE_MERGE_SECONDS PRIV_SANITIZER_BLUR_STRENGTH PRIV_SANITIZER_BLUR_RADIUS PRIV_SANITIZER_BLUR_OPACITY PRIV_SANITIZER_FACE_PADDING PRIV_SANITIZER_AGGRESSIVE; do
  if [[ -n "${!ENV_NAME:-}" ]]; then
    DOCKER_ARGS+=(--env "$ENV_NAME=${!ENV_NAME}")
  fi
done

DOCKER_WORKDIR="$(pwd -P)"
DOCKER_COMMAND=("$@")
for index in "${!DOCKER_COMMAND[@]}"; do
  argument="${DOCKER_COMMAND[$index]}"
  if [[ "$argument" == "$PWD" ]]; then
    DOCKER_COMMAND[$index]="/work"
  elif [[ "$argument" == "$PWD"/* ]]; then
    DOCKER_COMMAND[$index]="/work/${argument#"$PWD"/}"
  elif [[ "$argument" == "$DOCKER_WORKDIR" ]]; then
    DOCKER_COMMAND[$index]="/work"
  elif [[ "$argument" == "$DOCKER_WORKDIR"/* ]]; then
    DOCKER_COMMAND[$index]="/work/${argument#"$DOCKER_WORKDIR"/}"
  fi
done

exec docker "${DOCKER_ARGS[@]}" "$DOCKER_IMAGE" "${DOCKER_COMMAND[@]}"
